{
  "name": "devkit-lan-webcam",
  "version": "1.1.1",
  "description": "Any camera on your local network becomes a webcam on the PC; the web app streams it and lets other devices watch",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p . && vite build",
    "unit": "vitest",
    "unit:coverage": "vitest --coverage --watch=false",
    "lint": "eslint . && tsc -p .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"web/**/*.{ts,tsx,css,html}\" \"*.{mts,json}\" --write",
    "format:check": "prettier \"web/**/*.{ts,tsx,css,html}\" \"*.{mts,json}\" --check",
    "check:all": "pnpm run format:check && pnpm run lint && pnpm run unit:coverage && pnpm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.62.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
